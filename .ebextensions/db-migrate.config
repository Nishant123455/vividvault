container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate"
    leader_only: true

  02_createsuperuser:
    command: |
      source /var/app/venv/*/bin/activate
      echo "
from django.contrib.auth import get_user_model
User = get_user_model()
if not User.objects.filter(email='Nishantmishra7909@gmail.com').exists():
    User.objects.create_superuser('Nishant', 'Mishra', 'Nishantmishra7909@gmail.com', 'Nishant', 'Nk3986345.nkm@')
" | python manage.py shell
    leader_only: true
option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: vividvault.settings