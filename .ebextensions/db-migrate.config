container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate"
    leader_only: true

  02_createsuperuser:
    command: >
      source /var/app/venv/*/bin/activate &&
      python manage.py shell -c "
from django.contrib.auth import get_user_model;
User = get_user_model();
email='Nishantmishra7909@gmail.com';
if not User.objects.filter(email=email).exists():
    User.objects.create_superuser('Nishant','Mishra',email,'Nishant','Nk3986345.nkm@')
"
    leader_only: true

option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: vividvault.settings